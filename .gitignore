# Publication allowlist: update .publish-policy.json and matching exceptions together.
*
!/.gitattributes
!/.githooks/
!/.githooks/pre-commit
!/.githooks/pre-push
!/.gitignore
!/.node-version
!/.publish-policy.json
!/ARCHITECTURE.md
!/ASSET_MANIFEST.md
!/README.md
!/THIRD_PARTY_NOTICES.md
!/index.html
!/scripts/
!/scripts/check-public.mjs
!/styles/
!/styles/**
!/js/
!/js/**
!/assets/
!/assets/sounds/
!/assets/sounds/**
!/third_party/
!/third_party/**

# Local files and sensitive data stay outside Git.
.git/
.agents/
.codex/
node_modules/
tests/
test/
tmp/
qa/
coverage/
test-results/
playwright-report/
backups/
dist/
artifacts/
_packs/
2D_version/
DEMO.html
*prompt*
agent.md
AGENTS.md
PLAN.md
RELEASE_DESIGN.md
.env
.env.*
!.env.example
*.sqlite*
*.db
*.db-*
